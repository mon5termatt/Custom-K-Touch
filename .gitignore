# ESP-IDF build artifacts
build/
sdkconfig
sdkconfig.old
managed_components/
dependencies.lock

# Python
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Local secrets / device config (never commit API keys or IPs)
firmware/main/printers.h

# Image-asset sources. The generated firmware/main/pt_*.c ARE committed so the
# firmware builds out of the box; the raw PNG sources they were rasterized from
# are kept locally only.
firmware/assets/

# Local research / scratch (not needed to flash or install)
spike/
tmp_*
*/tmp_*
tmp_save_xl.py

# Working notes kept locally, not part of the shipped repo
PROJECT_PLAN.md
ROADMAP.md
FINDINGS.md
UI_DESIGN.md
PRUSALINK_PARITY.md

# Local Claude Code config + agent memory (contains personal data — never commit)
.claude/

# Release artifacts (the merged image is published on GitHub Releases, not tracked here)
*.bin

# Local dev helpers / scratch
read_logs.py

# UI simulator build output (the sim sources ARE committed; its build artifacts are not)
firmware/sim/build/
firmware/sim/out/

# Build / flash / capture logs + screenshots (dev only).
# Keep CMakeLists.txt — it's the top-level ESP-IDF project file, not a log.
firmware/*.txt
!firmware/CMakeLists.txt
firmware/*.bmp
firmware/*.png
firmware/flash_log_*
firmware/build_log_*

# Captured console logs + monitor state (the loggers live in firmware/scripts/).
*.log
.serial_check_state
.netlog_check_state
/serial_logger.py
/netlog_monitor.py
