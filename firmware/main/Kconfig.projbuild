menu "Prusa-Touch Configuration"

    config PP_WIFI_SSID
        string "WiFi SSID"
        default "myssid"
        help
            SSID (network name) the screen connects to.

    config PP_WIFI_PASSWORD
        string "WiFi password"
        default "mypassword"
        help
            WPA2 password for the WiFi network.

    config PP_PRINTER_HOST
        string "PrusaLink host (IP or hostname)"
        default "192.168.1.50"
        help
            Address of the Prusa printer's PrusaLink (or the Pi running PrusaLink
            for an MK3/MK3S).

    config PP_PRINTER_PORT
        int "PrusaLink port"
        default 80
        help
            HTTP port for PrusaLink. Usually 80.

    config PP_PRINTER_APIKEY
        string "PrusaLink API key (preferred)"
        default ""
        help
            PrusaLink API key, sent as the X-Api-Key header. This is how
            PrusaSlicer/OrcaSlicer authenticate to PrusaLink and is the simplest
            method. Leave blank to fall back to Digest (username/password) below.

    config PP_PRINTER_USER
        string "PrusaLink Digest username (fallback)"
        default "maker"
        help
            Used only if the API key is blank. PrusaLink Digest username is "maker".

    config PP_PRINTER_PASSWORD
        string "PrusaLink Digest password (fallback)"
        default "changeme"
        help
            Used only if the API key is blank. The PrusaLink password shown on the
            printer (Settings -> Network). Used for HTTP Digest authentication.

    config PP_STORAGE
        string "Default storage name"
        default "local"
        help
            Storage identifier used in /api/v1/files/<storage>/...  Typically
            "local" (printer flash/SD) or "usb".

    config PP_POLL_INTERVAL_MS
        int "Status poll interval (ms)"
        default 1000
        range 200 10000
        help
            How often to poll /api/v1/status.

    config PP_UPDATE_REPO
        string "GitHub repo for auto-update (owner/name)"
        default "nomadsgalaxy/Prusa-Connect-Touch"
        help
            Releases of this GitHub repo are checked by the auto-updater. The latest
            release's .bin asset is downloaded and OTA-flashed on demand.

endmenu
